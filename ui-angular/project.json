{
  "name": "ui-angular",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "ui-angular/src",
  "prefix": "bmb",
  "projectType": "library",
  "tags": [],
  "targets": {
    "sync-shared": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/src/lib/_shared"],
      "options": {
        "command": "rm -rf ui-angular/src/lib/_shared ui-angular/src/assets && mkdir -p ui-angular/src/lib/_shared && cp -R shared/logic ui-angular/src/lib/_shared/logic && cp -R shared/types ui-angular/src/lib/_shared/types && cp -R shared/assets ui-angular/src/assets && node -e \"const fs=require('fs');const files=['ui-angular/src/lib/_shared/types/index.ts','ui-angular/src/lib/_shared/logic/utils.ts','ui-angular/src/lib/_shared/logic/timestreamFilters.ts'];for(const f of files){let t=fs.readFileSync(f,'utf8');t=t.replaceAll('../../ui-angular/src/lib/','../../');fs.writeFileSync(f,t);}\"",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/ui-angular"],
      "dependsOn": ["sync-shared"],
      "options": {
        "project": "ui-angular/ng-package.json",
        "tsConfig": "ui-angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "ui-angular/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "dependsOn": ["sync-shared"],
      "options": {
        "jestConfig": "ui-angular/jest.config.cts",
        "tsConfig": "ui-angular/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "ui-angular/.storybook",
        "browserTarget": "angular-app:storybook-browser:production",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/ui-angular",
        "configDir": "ui-angular/.storybook",
        "browserTarget": "angular-app:storybook-browser:production",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c ui-angular/.storybook --url=http://localhost:4400"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "ui-angular:build-storybook",
        "staticFilePath": "dist/storybook/ui-angular",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "ui-angular:build-storybook:ci"
        }
      }
    }
  }
}
