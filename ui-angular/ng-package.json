{
  "$schema": "../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../dist/ui-angular",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "allowedNonPeerDependencies": [
    "@material-symbols/svg-400",
    "dompurify",
    "luxon",
    "tslib"
  ],
  "assets": [
    {
      "glob": "**/*",
      "input": "src/assets",
      "output": "assets"
    }
  ]
}
