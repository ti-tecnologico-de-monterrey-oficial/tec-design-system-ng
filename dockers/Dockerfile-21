# Usar Node.js compatible
FROM node:22-alpine  AS builder

# Establecer el directorio de trabajo dentro del contenedor
WORKDIR /app

# Copiar los archivos de configuración de dependencias
COPY . .
COPY package/v21.json ./package.json

# Usar npm con la correccion del resolver de peer dependencies
RUN npm install --global npm@11.21.1 && rm -f package-lock.json && npm install

# Construye la librería de Angular (ajusta el nombre de tu librería)
RUN sed -i 's/"ignoreDeprecations": "6.0"/"ignoreDeprecations": "5.0"/' ui-angular/tsconfig.lib.json && npm run docker-build

# --- Extrae el resultado ---
FROM alpine:latest AS output

# Copia los archivos construidos desde la etapa anterior
COPY --from=builder /app/dist/ui-angular /ui-angular
