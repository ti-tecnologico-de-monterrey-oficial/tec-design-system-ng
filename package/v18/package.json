{
  "name": "@ti-tecnologico-de-monterrey-oficial/tec-design-system-ng",
  "version": "1.0.0",
  "description": "Design System oficial del Tecnológico de Monterrey - Descubre cómo nuestro Design System no solo da forma a la estética, sino que también impulsa la consistencia en cada rincón de nuestro diseño, proporcionando una base sólida para construir experiencias memorables y coherentes. Únete a nosotros en este viaje donde la creatividad, coherencia y elegancia se encuentran para dar vida a un mundo visualmente armonioso y funcionalmente fluido.",
  "keywords": [
    "angular",
    "ui",
    "Tecnológico de Monterrey"
  ],
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "storybook": "ng run ds-ng:storybook",
    "start": "ng serve",
    "watch": "ng build --watch --configuration development",
    "test": "npm run lint && npm run format-check && ng test ds-ng",
    "build-storybook": "ng run ds-ng:build-storybook",
    "build": "ng build",
    "chromatic": "npx chromatic",
    "build:styles": "npm run build:TEC && npm run build:TECMI && npm run build:GED",
    "build:TEC": "sass projects/ds-ng/src/assets/styles/mainTEC.scss dist/ds-ng/assets/styles/mainTEC.min.css --style=compressed",
    "build:GED": "sass projects/ds-ng/src/assets/styles/mainGED.scss dist/ds-ng/assets/styles/mainGED.min.css --style=compressed",
    "build:TECMI": "sass projects/ds-ng/src/assets/styles/mainTECMI.scss dist/ds-ng/assets/styles/mainTECMI.min.css --style=compressed",
    "build:lib": "ng build ds-ng --configuration production && npm run build:styles && npm run build:micro && npm run build:git-micro && npm run version",
    "docker-build": "ng build ds-ng --configuration production && npm run build:styles",
    "changelog:default": "auto-changelog -p --output CHANGELOG.md --template keepachangelog",
    "changelog:custom": "auto-changelog -p --output FEATURES.md --template changelog-template.hbs",
    "version": "npm run changelog:default && npm run changelog:custom && git add CHANGELOG.md FEATURES.md",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format-check": "prettier --check \"src/**/*.ts\"",
    "compodoc:build": "compodoc -p tsconfig.doc.json",
    "compodoc:build-and-serve": "compodoc -p tsconfig.doc.json -s",
    "compodoc:serve": "compodoc -s",
    "build:micro": "sass projects/ds-ng/src/assets/styles/micro.scss dist/ds-ng/assets/styles/micro.min.css --style=compressed",
    "build:git-micro": "sass projects/ds-ng/src/assets/styles/micro.scss projects/ds-ng/src/lib/foundations/micro.min.css --style=compressed",
    "publish:beta": "node publish.js --beta",
    "publish:latest": "node publish.js"
  },
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "template": "keepachangelog",
    "unreleased": true,
    "commitLimit": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ti-tecnologico-de-monterrey-oficial/tec-design-system-ng.git"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "^18.2.13",
    "@angular/cdk": "^18.2.14",
    "@angular/common": "^21.2.1",
    "@angular/compiler": "^21.2.1",
    "@angular/core": "^21.2.1",
    "@angular/elements": "^18.2.13",
    "@angular/forms": "^18.2.13",
    "@angular/material": "^18.2.14",
    "@angular/platform-browser": "^18.2.13",
    "@angular/platform-browser-dynamic": "^18.2.13",
    "@angular/router": "^18.2.13",
    "@material-symbols/svg-400": "^0.39.1",
    "dompurify": "^3.3.0",
    "dotenv": "^16.4.7",
    "libphonenumber-js": "^1.11.16",
    "luxon": "^3.5.0",
    "rxjs": "~7.8.0",
    "tslib": "2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.15",
    "@angular-eslint/builder": "18.4.3",
    "@angular-eslint/eslint-plugin": "18.4.3",
    "@angular-eslint/eslint-plugin-template": "18.4.3",
    "@angular-eslint/schematics": "18.4.3",
    "@angular-eslint/template-parser": "18.4.3",
    "@angular/cli": "^18.2.15",
    "@angular/compiler-cli": "^18.2.13",
    "@compodoc/compodoc": "^1.1.24",
    "@types/jasmine": "~5.1.0",
    "@types/luxon": "^3.4.2",
    "@typescript-eslint/eslint-plugin": "7.2.0",
    "@typescript-eslint/parser": "7.2.0",
    "auto-changelog": "^2.4.0",
    "chromatic": "^11.22.2",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.11.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "file-loader": "^6.2.0",
    "husky": "^9.1.7",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^18.2.1",
    "prettier": "^3.2.5",
    "prettier-eslint": "^16.3.0",
    "sass": "^1.86.0",
    "typescript": "~5.4.2"
  },
  "files": [
    "projects/ds-ng/dist",
    "projects/ds-ng/src/assets"
  ],
  "bugs": {
    "url": "https://github.com/ti-tecnologico-de-monterrey-oficial/tec-design-system-ng/issues"
  },
  "homepage": "https://github.com/ti-tecnologico-de-monterrey-oficial/tec-design-system-ng#readme"
}
