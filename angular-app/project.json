{
  "name": "angular-app",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "angular-app/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/angular-app",
        "browser": "angular-app/src/main.ts",
        "tsConfig": "angular-app/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "angular-app/public"
          },
          {
            "glob": "**/*",
            "input": "shared/assets",
            "output": "assets"
          }
        ],
        "styles": ["angular-app/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "storybook-browser": {
      "executor": "@angular-devkit/build-angular:browser",
      "options": {
        "outputPath": "dist/angular-app-storybook-browser",
        "index": "angular-app/src/index.html",
        "main": "angular-app/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "angular-app/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "angular-app/public"
          },
          {
            "glob": "**/*",
            "input": "shared/assets",
            "output": "assets"
          }
        ],
        "styles": [
          "angular-app/src/styles.css",
          "shared/assets/styles/storybook-theme.scss",
          "shared/assets/styles/mainSB.scss",
          "shared/assets/styles/tokens/theme.scss"
        ],
        "scripts": []
      },
      "configurations": {
        "development": {
          "sourceMap": true,
          "optimization": false,
          "namedChunks": true,
          "vendorChunk": true,
          "buildOptimizer": false
        },
        "production": {
          "sourceMap": false,
          "optimization": true,
          "namedChunks": false,
          "vendorChunk": false,
          "buildOptimizer": true
        }
      },
      "defaultConfiguration": "development"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "angular-app:build:production"
        },
        "development": {
          "buildTarget": "angular-app:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "angular-app/jest.config.cts",
        "tsConfig": "angular-app/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "angular-app:build",
        "port": 4200,
        "staticFilePath": "dist/angular-app/browser",
        "spa": true
      }
    }
  }
}
