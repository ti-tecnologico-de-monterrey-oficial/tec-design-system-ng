{
  "name": "ui-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "lib/ui-angular/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "project": "lib/ui-angular/ng-package.json",
        "tsConfig": "lib/ui-angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "lib/ui-angular/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "lib/ui-angular/.storybook",
        "browserTarget": "ui-angular:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": [
        "{options.outputDir}"
      ],
      "options": {
        "outputDir": "dist/storybook/ui-angular",
        "configDir": "lib/ui-angular/.storybook",
        "browserTarget": "ui-angular:build-storybook",
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": [
        "build-storybook"
      ],
      "options": {
        "buildTarget": "ui-angular:build-storybook",
        "staticFilePath": "dist/storybook/ui-angular",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "ui-angular:build-storybook:ci"
        }
      }
    }
  }
}
