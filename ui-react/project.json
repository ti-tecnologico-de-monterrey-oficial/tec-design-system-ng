{
  "name": "ui-react",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "ui-react/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project ui-react --web",
  "targets": {
    "sync-shared": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/src/lib/_shared",
        "{workspaceRoot}/dist/ui-react/assets/shared"
      ],
      "options": {
        "command": "node scripts/sync-react-shared.mjs"
      }
    },
    "build": {
      "dependsOn": ["^build", "sync-shared"]
    },
    "test": {
      "dependsOn": [
        { "projects": ["ui-angular"], "target": "check-shared-import-boundaries" },
        "sync-shared"
      ]
    }
  }
}
